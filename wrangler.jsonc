// Cloudflare Workers static site: serves docs/ (home page, privacy policy, rules.json).
// Deployed by Cloudflare's GitHub integration on every push to main (`npx wrangler deploy`).
{
  "name": "screenhop",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./docs",
    "not_found_handling": "404-page"
  }
}
