// Cloudflare Workers site: serves docs/ (home page, privacy policy, rules.json, sponsors.json).
// Deployed by Cloudflare's GitHub integration on every push to main (`npx wrangler deploy`).
// site/worker.js runs only for the sponsor paths (country, impression counts, QR redirects);
// everything else is a plain static asset.
{
  "name": "screenatic",
  "compatibility_date": "2025-09-01",
  "main": "site/worker.js",
  "assets": {
    "directory": "./docs",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/sponsors.json", "/sponsors-dev.json", "/px", "/c/*"]
  },
  // Sponsor reach (aggregate counts, no IPs or device IDs); queried by scripts/sponsor-report.sh.
  "analytics_engine_datasets": [
    { "binding": "SPONSOR_STATS", "dataset": "screenatic_sponsor_events" }
  ]
}
