+/* Screenatic: a "no data" packet (the sender is silent) took seqnum seq. Nothing will ever fill
+ * it, so let the buffer pass over it instead of waiting for and requesting a resend: otherwise
+ * every pause in the sound (switching apps) left a gap of hundreds of packets, triggered a flood
+ * of resends of empty packets, and held back the audio after it for about a second. Only moves
+ * over entries that are empty, so queued audio before it is still played. */
+void raop_buffer_skip_empty(raop_buffer_t *raop_buffer, unsigned short seq) {
+    assert(raop_buffer);
+    if (raop_buffer->is_empty) {
+        raop_buffer->first_seqnum = seq + 1;
+        raop_buffer->last_seqnum = seq;
+        raop_buffer->is_empty = 0;
+        return;
+    }
+    if (seqnum_cmp(seq, raop_buffer->first_seqnum) < 0) return;  /* already behind us */
+    if (seqnum_cmp(seq, raop_buffer->first_seqnum + RAOP_BUFFER_LENGTH) >= 0) {
+        raop_buffer_flush(raop_buffer, seq + 1);
+        return;
+    }
+    while (seqnum_cmp(raop_buffer->first_seqnum, seq) <= 0 &&
+           !raop_buffer->entries[raop_buffer->first_seqnum % RAOP_BUFFER_LENGTH].filled) {
+        raop_buffer->first_seqnum += 1;
+    }
+    if (seqnum_cmp(seq, raop_buffer->last_seqnum) > 0) {
+        raop_buffer->last_seqnum = seq;
+    }
+}
