+/* Screenatic: host used in the playlist URLs handed to the media player. The player of a
+ * sandboxed TV app (Vega OS) runs in another process/network namespace where localhost is not
+ * this app, so it gets the TV's LAN address instead. */
+static char screenatic_hls_host[64] = "localhost";
+
+void airplay_video_set_local_host(const char *host) {
+    if (!host || !*host) host = "localhost";
+    snprintf(screenatic_hls_host, sizeof(screenatic_hls_host), "%s", host);
+}
